{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sme-prefetch/hardware-profile-v1.1.schema.json",
  "title": "SME Prefetch HardwareProfile 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "generated_utc",
    "source",
    "system",
    "cache_topology",
    "measurements",
    "derived",
    "quality",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "profile_id": {"type": "string", "minLength": 1},
    "generated_utc": {"type": "string", "minLength": 1},
    "source": {"const": "measured"},
    "system": {
      "type": "object",
      "additionalProperties": true,
      "required": ["os", "kernel", "architecture", "cpu_model", "logical_cpus", "frequency_ghz_observed", "frequency_source"]
    },
    "cache_topology": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "type", "size_bytes", "line_bytes", "ways", "sets", "shared_cpu_list"],
        "properties": {
          "level": {"type": "integer", "minimum": 1},
          "type": {"type": "string", "minLength": 1},
          "size_bytes": {"type": ["integer", "null"], "minimum": 1},
          "line_bytes": {"type": ["integer", "null"], "minimum": 1},
          "ways": {"type": ["integer", "null"], "minimum": 1},
          "sets": {"type": ["integer", "null"], "minimum": 1},
          "shared_cpu_list": {"type": ["string", "null"]}
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency", "stride", "prefetch", "bandwidth", "reported_system"],
      "properties": {
        "latency": {"$ref": "#/$defs/measurementPoints"},
        "stride": {"$ref": "#/$defs/measurementPoints"},
        "prefetch": {"$ref": "#/$defs/measurementPoints"},
        "reported_system": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cache_line_bytes", "l1_cache_bytes", "l2_cache_bytes", "l3_cache_bytes"],
          "properties": {
            "cache_line_bytes": {"type": ["integer", "null"], "minimum": 1},
            "l1_cache_bytes": {"type": ["integer", "null"], "minimum": 1},
            "l2_cache_bytes": {"type": ["integer", "null"], "minimum": 1},
            "l3_cache_bytes": {"type": ["integer", "null"], "minimum": 1}
          }
        },
        "bandwidth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["working_set_bytes", "rounds", "bytes_per_ns_median", "bytes_per_ns_minimum", "bytes_per_ns_maximum", "samples"],
          "properties": {
            "working_set_bytes": {"type": "integer", "minimum": 1},
            "rounds": {"type": "integer", "minimum": 1},
            "bytes_per_ns_median": {"type": "number", "exclusiveMinimum": 0},
            "bytes_per_ns_minimum": {"type": "number", "exclusiveMinimum": 0},
            "bytes_per_ns_maximum": {"type": "number", "exclusiveMinimum": 0},
            "samples": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}}
          }
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cache_line_bytes",
        "l1d_bytes",
        "l2_bytes",
        "l1_hit_latency_ns",
        "l2_hit_latency_ns",
        "memory_latency_ns",
        "memory_latency_cycles_estimate",
        "sustainable_bandwidth_bytes_per_ns",
        "prefetch_instruction_cost_ns",
        "prefetch_instruction_cost_cycles_estimate",
        "prefetch_issue_measurements",
        "hardware_prefetch_effective_stride_bytes_heuristic",
        "max_outstanding_prefetches"
      ],
      "properties": {
        "cache_line_bytes": {"$ref": "#/$defs/positiveNumberOrNull"},
        "l1d_bytes": {"$ref": "#/$defs/positiveNumberOrNull"},
        "l2_bytes": {"$ref": "#/$defs/positiveNumberOrNull"},
        "l1_hit_latency_ns": {"$ref": "#/$defs/positiveNumberOrNull"},
        "l2_hit_latency_ns": {"$ref": "#/$defs/positiveNumberOrNull"},
        "memory_latency_ns": {"$ref": "#/$defs/positiveNumberOrNull"},
        "memory_latency_cycles_estimate": {"$ref": "#/$defs/positiveNumberOrNull"},
        "sustainable_bandwidth_bytes_per_ns": {"$ref": "#/$defs/positiveNumberOrNull"},
        "prefetch_instruction_cost_ns": {"$ref": "#/$defs/positiveNumberOrNull"},
        "prefetch_instruction_cost_cycles_estimate": {"$ref": "#/$defs/positiveNumberOrNull"},
        "prefetch_issue_measurements": {"type": "array", "items": {"type": "object"}},
        "hardware_prefetch_effective_stride_bytes_heuristic": {"type": ["integer", "null"], "minimum": 1},
        "max_outstanding_prefetches": {"$ref": "#/$defs/positiveNumberOrNull"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "repetitions", "warnings", "prefetch_instruction_verified_in_assembly"],
      "properties": {
        "mode": {"enum": ["quick", "full"]},
        "repetitions": {"type": "integer", "minimum": 1},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "prefetch_instruction_verified_in_assembly": {"type": "boolean"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tool", "tool_version", "compiler", "probe_source_sha256", "assembly_sha256"]
    }
  },
  "$defs": {
    "positiveNumberOrNull": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "measurementPoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "median", "minimum", "maximum", "samples"],
        "properties": {
          "key": {"type": "integer", "minimum": 0},
          "median": {"type": "number", "minimum": 0},
          "minimum": {"type": "number", "minimum": 0},
          "maximum": {"type": "number", "minimum": 0},
          "samples": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}}
        }
      }
    }
  }
}
