# 现场环境配置：复制为 site.env 并填写，然后
#   bash onsite_run_experiment.sh site.env
#
# 也可以不建文件，直接 export 这些变量。未设置时会自动探测常见路径。

# LLVM / Triton-Shared 工具链
LLVM_INSTALL_DIR=/home/share/llvm20/llvm-project/install
TRITON_SHARED_OPT=/home/share/triton/triton-cpu/python/build/cmake.linux_aarch64-cpython-3.11/third_party/triton_shared/tools/triton-shared-opt/triton-shared-opt
COMPILER_PY=/home/share/triton/triton-cpu/triton-shared/backend/compiler.py

# 本次真实 00_input.mlir（TRITON_SHARED_DUMP_PATH/bmm_kernel/00_input.mlir）
INPUT_00=

# FlagGems 目录与 pytest 命令（正确性验证用）
FLAGGEMS_DIR=/home/share/triton/triton-cpu/FlagGems
PYTEST_CMD='pytest -s tests/test_blas_ops_mem.py::test_accuracy_bmm_membound[dtype2-8192-64-2048]'

# 输出目录（脚本会在这里建 run-<时间戳>）
EXPERIMENT_OUT=

# benchmark 参数
SME_BENCH_BATCH=4
SME_BENCH_M=8192
SME_BENCH_N=2048
SME_BENCH_K=64
SME_BENCH_DTYPE=bfloat16
SME_BENCH_WARMUP=5
SME_BENCH_REP=20
